# --- Local OpenAI-compatible LLM server (LM Studio) ---
LMSTUDIO_BASE_URL=http://10.42.80.38:1234/v1
LMSTUDIO_API_KEY=lm-studio
LLM_MODEL=liquid/lfm2.5-1.2b
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=768

# --- Embeddings ---
EMBED_MODEL=bge-small
LMSTUDIO_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
EMBED_DEVICE=auto

# --- Chunking ---
CHUNKER=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_STRATEGY=rerank
TOP_K=3
FETCH_K=20

# --- Corrective RAG ---
CRAG_ENABLED=false

LOG_LEVEL=INFO
